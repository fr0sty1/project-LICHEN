{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OASIS MQTT-SN 1.2 transport vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format_version", "name", "description", "spec", "vectors"],
  "properties": {
    "$schema": {"const": "./mqtt_sn.schema.json"},
    "format_version": {"const": 2},
    "name": {"const": "mqtt_sn"},
    "description": {"type": "string", "minLength": 1},
    "spec": {"type": "string", "minLength": 1},
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "expected"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "kind": {"enum": ["wire", "reject", "type_table"]},
          "expected": {"enum": ["accept", "reject"]},
          "reason": {"type": "string"},
          "msg_type": {"type": "integer", "minimum": 0, "maximum": 255},
          "msg_type_name": {"type": "string"},
          "encoded": {"type": "string", "pattern": "^([0-9a-f]{2})*$"},
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "integer", "boolean"]
            }
          },
          "types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "code"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "code": {"type": "integer", "minimum": 0, "maximum": 255}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "wire"}}, "required": ["kind"]},
            "then": {"required": ["encoded", "msg_type", "msg_type_name", "fields"]}
          },
          {
            "if": {"properties": {"kind": {"const": "reject"}}, "required": ["kind"]},
            "then": {"required": ["encoded", "reason"]}
          },
          {
            "if": {"properties": {"kind": {"const": "type_table"}}, "required": ["kind"]},
            "then": {"required": ["types"]}
          }
        ]
      }
    }
  }
}

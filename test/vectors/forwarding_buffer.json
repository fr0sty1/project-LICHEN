    {
      "name": "lru_touch_updates_order",
      "description": "Touching a source moves it to MRU; evicts true LRU.",
      "operation": "try_buffer",
      "precondition": {
        "description": "Source 1 touched after sources 2,3 so source 2 is LRU",
        "state": {
          "sources": {
            "0000000000000001": [
              {
                "packet_id": "s1_p1",
                "deadline_ms": 10000
              },
              {
                "packet_id": "s1_p2",

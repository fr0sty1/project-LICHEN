{
  "vector_type": "forwarding_buffer",
  "format_version": 1,
  "description": "Canonical test vectors for B.3.2 Forwarding Buffer (spec appendix-bufferbloat.md). Validates per-source limits, LRU eviction, deadline expiry, and backpressure.",
  "oracle": {
    "basis": "spec/appendix-bufferbloat.md section 'Forwarding Buffer'",
    "max_forwarding_sources": 8,
    "max_packets_per_source": 2,
    "total_capacity": 16,
    "eviction_policy": "LRU by source (oldest untouched source evicted)",
    "backpressure_trigger": "per-source limit reached",
    "expiry_condition": "deadline_ms <= now_ms",
    "dequeue_order": "FIFO within source"
  },
  "vectors": [
    {
      "name": "accept_first_packet",
      "description": "First packet from a new source is accepted.",
      "operation": "try_buffer",
      "inputs": {
        "packet_id": "pkt1",
        "source_iid": "0000000000000001",
        "now_ms": 0,
        "deadline_ms": 10000
      },
      "expected": {
        "result": "ACCEPTED",
        "state": {
          "sources": {
            "0000000000000001": [
              {
                "packet_id": "pkt1",
                "deadline_ms": 10000
              }
            ]
          },
          "source_order": [
            "0000000000000001"
          ],
          "stats": {
            "total_packets": 1,
            "sources": 1,
            "max_sources": 8,
            "max_per_source": 2,
            "accepted": 1,
            "backpressure": 0,
            "expired": 0,
            "evicted": 0
          }
        }
      }
    },
    {
      "name": "accept_second_packet_same_source",
      "description": "Second packet from same source (under limit) is accepted.",
      "operation": "try_buffer",
      "inputs": {
        "packet_id": "pkt2",
        "source_iid": "0000000000000001",
        "now_ms": 1,
        "deadline_ms": 10000
      },
      "expected": {
        "result": "ACCEPTED",
        "state": {
          "sources": {
            "0000000000000001": [
              {
                "packet_id": "pkt1",
                "deadline_ms": 10000
              },
              {
                "packet_id": "pkt2",
                "deadline_ms": 10000
              }
            ]
          },
          "source_order": [
            "0000000000000001"
          ],
          "stats": {
            "total_packets": 2,
            "sources": 1,
            "max_sources": 8,
            "max_per_source": 2,
            "accepted": 2,
            "backpressure": 0,
            "expired": 0,
            "evicted": 0
          }
        }
      }
    },
    {
      "name": "backpressure_at_per_source_limit",
      "description": "Third packet from same source triggers backpressure (NACK).",
      "operation": "try_buffer",
      "inputs": {
        "packet_id": "pkt3",
        "source_iid": "0000000000000001",
        "now_ms": 2,
        "deadline_ms": 10000
      },
      "expected": {
        "result": "BACKPRESSURE",
        "state": {
          "sources": {
            "0000000000000001": [
              {
                "packet_id": "pkt1",
                "deadline_ms": 10000
              },
              {
                "packet_id": "pkt2",
                "deadline_ms": 10000
              }
            ]
          },
          "source_order": [
            "0000000000000001"
          ],
          "stats": {
            "total_packets": 2,
            "sources": 1,
            "max_sources": 8,
            "max_per_source": 2,
            "accepted": 2,
            "backpressure": 1,
            "expired": 0,
            "evicted": 0
          }
        }
      }
    },

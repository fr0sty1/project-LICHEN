{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LICHEN routing address classification vectors",
  "type": "object",
  "required": ["$schema", "format_version", "name", "description", "spec", "classifications", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "./address_classification.schema.json"},
    "format_version": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "spec": {"type": "string", "minLength": 1},
    "classifications": {
      "type": "object",
      "required": ["direct_neighbor", "local_mesh", "identity_preserving_global", "off_mesh"],
      "additionalProperties": false,
      "properties": {
        "direct_neighbor": {"type": "string", "minLength": 1},
        "local_mesh": {"type": "string", "minLength": 1},
        "identity_preserving_global": {"type": "string", "minLength": 1},
        "off_mesh": {"type": "string", "minLength": 1}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/scenario"}
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "required": ["name", "max_peers", "operations"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "max_peers": {"type": "integer", "minimum": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/operation"}
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["op", "address", "now_s", "expected_size"],
      "additionalProperties": false,
      "properties": {
        "op": {"enum": ["classify", "update"]},
        "address": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "now_s": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "expected_size": {"type": "integer", "minimum": 0},
        "expected_expires_at_s": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "expected_classification": {"enum": ["direct_neighbor", "local_mesh", "identity_preserving_global", "off_mesh"]},
        "expected_error": {"enum": ["invalid_source", "non_primary", "capacity", "time_regression", "timestamp_overflow", "invalid_address"]}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "update"}}},
          "then": {
            "required": ["source"],
            "oneOf": [
              {"required": ["expected_expires_at_s"]},
              {"required": ["expected_error"]}
            ]
          }
        },
        {
          "if": {"properties": {"op": {"const": "classify"}}},
          "then": {
            "oneOf": [
              {"required": ["expected_classification"]},
              {"required": ["expected_error"]}
            ]
          }
        }
      ]
    }
  }
}

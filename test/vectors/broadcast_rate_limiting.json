{
  "$schema": "./schema.json",
  "format_version": 2,
  "name": "broadcast_rate_limiting",
  "description": "Hop-aware broadcast rate limiting per spec §6.3.3. Each sender has per-hop-limit budgets enforced per rolling hour.",
  "spec": "spec/04-network.md#section-633-broadcast-rate-limiting",
  "vectors": [
    {
      "name": "budget_hl1_accept_within",
      "description": "HL=1 budget is 200/hr. Accept 200th packet from same sender.",
      "hop_limit": 1,
      "sender_iid": "0011223344556677",
      "count_in_window": 199,
      "expected": {
        "action": "relay",
        "budget": 200,
        "reason": "within_budget"
      }
    },
    {
      "name": "budget_hl1_reject_exceeded",
      "description": "HL=1 budget is 200/hr. Reject 201st packet from same sender.",
      "hop_limit": 1,
      "sender_iid": "0011223344556677",
      "count_in_window": 200,
      "expected": {
        "action": "drop",
        "budget": 200,
        "reason": "budget_exceeded"
      }
    },
    {
      "name": "budget_hl2_accept_within",
      "description": "HL=2 budget is 100/hr. Accept 100th packet.",
      "hop_limit": 2,
      "sender_iid": "0011223344556677",
      "count_in_window": 99,
      "expected": {
        "action": "relay",
        "budget": 100,
        "reason": "within_budget"
      }
    },
    {
      "name": "budget_hl2_reject_exceeded",
      "description": "HL=2 budget is 100/hr. Reject 101st packet.",
      "hop_limit": 2,
      "sender_iid": "0011223344556677",
      "count_in_window": 100,
      "expected": {
        "action": "drop",
        "budget": 100,
        "reason": "budget_exceeded"
      }
    },
    {
      "name": "budget_hl3_medium_radius",
      "description": "HL=3-4 budget is 30/hr. Accept 30th, reject 31st.",
      "hop_limit": 3,
      "sender_iid": "0011223344556677",
      "count_in_window": 29,
      "expected": {
        "action": "relay",
        "budget": 30,
        "reason": "within_budget"
      }
    },
    {
      "name": "budget_hl4_medium_radius",
      "description": "HL=4 shares 30/hr budget with HL=3.",
      "hop_limit": 4,
      "sender_iid": "0011223344556677",
      "count_in_window": 30,
      "expected": {
        "action": "drop",
        "budget": 30,
        "reason": "budget_exceeded"
      }
    },
    {
      "name": "budget_hl5_mesh_wide",
      "description": "HL=5-7 (mesh-wide) budget is 10/hr. Reject 11th.",
      "hop_limit": 5,
      "sender_iid": "0011223344556677",
      "count_in_window": 10,
      "expected": {
        "action": "drop",
        "budget": 10,
        "reason": "budget_exceeded"
      }
    },
    {
      "name": "budget_hl7_mesh_wide",
      "description": "HL=7 shares 10/hr budget with HL=5-6.",
      "hop_limit": 7,
      "sender_iid": "0011223344556677",
      "count_in_window": 9,
      "expected": {
        "action": "relay",
        "budget": 10,
        "reason": "within_budget"
      }
    },
    {
      "name": "yellow_zone_probabilistic",
      "description": "At 50-100% budget, relay is probabilistic. count >= budget*0.5 enters yellow zone.",
      "hop_limit": 1,
      "sender_iid": "0011223344556677",
      "count_in_window": 100,
      "expected": {
        "action": "probabilistic",
        "budget": 200,
        "yellow_zone_threshold": 100,
        "reason": "yellow_zone_random_drop"
      }
    },
    {
      "name": "independent_per_sender",
      "description": "Different senders have independent budgets.",
      "hop_limit": 1,
      "scenarios": [
        {
          "sender_iid": "aabbccddeeff0011",
          "count_in_window": 200,
          "action": "drop"
        },
        {
          "sender_iid": "1122334455667788",
          "count_in_window": 0,
          "action": "relay"
        }
      ],
      "expected": {
        "reason": "per_sender_tracking"
      }
    },
    {
      "name": "state_expires_after_idle",
      "description": "Sender state expires after 2 hours idle, resetting budget.",
      "hop_limit": 1,
      "sender_iid": "0011223344556677",
      "count_in_window": 200,
      "idle_seconds": 7201,
      "expected": {
        "action": "relay",
        "budget": 200,
        "reason": "state_expired"
      }
    }
  ]
}

{
 "$schema": "./schema.json",
 "format_version": 2,
 "name": "rangetest",
 "description": "Range Testing CoAP resources per spec 12-apps.md section 18.7: extended range test (POST /diag/rangetest), continuous range test (GET /diag/rangetest), and traceroute (GET /diag/traceroute). Expected SenML/CBOR payloads are hand-derived from RFC 8428 Table 4 numeric labels and encoded with raw cbor2 independent of the lichen implementation; consumers MUST reproduce these bytes exactly.",
 "spec": "spec/12-apps.md section 18.7; RFC 8428; RFC 7641",
 "oracle": {
  "kind": "hand-derived",
  "tooling": "python3 + cbor2 (no lichen imports)",
  "notes": "SenML label order follows RFC 8428 Table 4; floats encode as 64-bit (0xfb); bt encodes as uint32 at this magnitude."
 },

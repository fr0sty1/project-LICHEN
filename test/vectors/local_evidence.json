{
  "$schema": "./local_evidence.schema.json",
  "format_version": 2,
  "name": "LOCAL_EVIDENCE_LIFETIME tracking",
  "description": "Deterministic lifetime, refresh, expiry, monotonic-time, overflow, and bounded-capacity scenarios for the LOADng local-evidence gate.",
  "spec": "spec/appendix-loadng.md#b22-route-cache-parameters",
  "lifetime_seconds": 1200,
  "default_max_peers": 32,
  "scenarios": [
    {
      "name": "exact_expiry_boundary",
      "max_peers": 2,
      "operations": [
        {"op": "refresh", "destination": "0200::1", "source": "announce", "now_s": 10, "expected_expires_at_s": 1210, "expected_size": 1},
        {"op": "has_evidence", "destination": "0200::1", "now_s": 1209, "expected_result": true, "expected_size": 1},
        {"op": "has_evidence", "destination": "0200::1", "now_s": 1210, "expected_result": false, "expected_size": 0}
      ]
    },
    {
      "name": "refresh_restarts_full_lifetime",
      "max_peers": 2,
      "operations": [
        {"op": "refresh", "destination": "0200::2", "source": "rrep", "now_s": 0, "expected_expires_at_s": 1200, "expected_size": 1},
        {"op": "refresh", "destination": "0200::2", "source": "data", "now_s": 1199, "expected_expires_at_s": 2399, "expected_size": 1},
        {"op": "has_evidence", "destination": "0200::2", "now_s": 2398, "expected_result": true, "expected_size": 1},
        {"op": "has_evidence", "destination": "0200::2", "now_s": 2399, "expected_result": false, "expected_size": 0}
      ]
    },
    {
      "name": "clock_regression_is_rejected_atomically",
      "max_peers": 2,
      "operations": [
        {"op": "refresh", "destination": "0200::3", "source": "rpl", "now_s": 100, "expected_expires_at_s": 1300, "expected_size": 1},
        {"op": "has_evidence", "destination": "0200::3", "now_s": 99, "expected_error": "time_regression", "expected_size": 1},
        {"op": "has_evidence", "destination": "0200::3", "now_s": 100, "expected_result": true, "expected_size": 1}
      ]
    },
    {
      "name": "u64_expiry_endpoint",
      "max_peers": 1,
      "operations": [
        {"op": "refresh", "destination": "0200::4", "source": "announce", "now_s": 18446744073709550415, "expected_expires_at_s": 18446744073709551615, "expected_size": 1},
        {"op": "has_evidence", "destination": "0200::4", "now_s": 18446744073709551614, "expected_result": true, "expected_size": 1},
        {"op": "has_evidence", "destination": "0200::4", "now_s": 18446744073709551615, "expected_result": false, "expected_size": 0}
      ]
    },
    {
      "name": "u64_expiry_overflow_is_rejected_atomically",
      "max_peers": 1,
      "operations": [
        {"op": "refresh", "destination": "0200::5", "source": "announce", "now_s": 18446744073709550416, "expected_error": "timestamp_overflow", "expected_size": 0},
        {"op": "refresh", "destination": "0200::5", "source": "announce", "now_s": 0, "expected_expires_at_s": 1200, "expected_size": 1}
      ]
    },
    {
      "name": "bounded_capacity_reuses_only_expired_slots",
      "max_peers": 2,
      "operations": [
        {"op": "refresh", "destination": "0200::a", "source": "announce", "now_s": 0, "expected_expires_at_s": 1200, "expected_size": 1},
        {"op": "refresh", "destination": "0200::b", "source": "rrep", "now_s": 1, "expected_expires_at_s": 1201, "expected_size": 2},
        {"op": "refresh", "destination": "0200::c", "source": "rpl", "now_s": 2, "expected_error": "capacity", "expected_size": 2},
        {"op": "has_evidence", "destination": "0200::a", "now_s": 2, "expected_result": true, "expected_size": 2},
        {"op": "has_evidence", "destination": "0200::b", "now_s": 2, "expected_result": true, "expected_size": 2},
        {"op": "refresh", "destination": "0200::c", "source": "data", "now_s": 1200, "expected_expires_at_s": 2400, "expected_size": 2},
        {"op": "has_evidence", "destination": "0200::a", "now_s": 1200, "expected_result": false, "expected_size": 2},
        {"op": "has_evidence", "destination": "0200::b", "now_s": 1200, "expected_result": true, "expected_size": 2},
        {"op": "has_evidence", "destination": "0200::c", "now_s": 1200, "expected_result": true, "expected_size": 2}
      ]
    },
    {
      "name": "unauthenticated_source_is_rejected_atomically",
      "max_peers": 1,
      "operations": [
        {"op": "refresh", "destination": "0200::6", "source": "unverified", "now_s": 0, "expected_error": "invalid_source", "expected_size": 0},
        {"op": "refresh", "destination": "0200::6", "source": "rpl", "now_s": 0, "expected_expires_at_s": 1200, "expected_size": 1}
      ]
    }
  ]
}

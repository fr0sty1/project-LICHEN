        "node": "0200:0000:0000:0000:0011:2233:4455:6677",
        "ts": 1716742800,
        "lat": 90.0,
        "lon": -180.0,
        "status": "ok"
      },
      "cbor_hex": "a5646e6f64657827303230303a303030303a303030303a303030303a303031313a323233333a343435353a363637376274731a66536a90636c6174fb4056800000000000636c6f6efbc06680000000000066737461747573626f6b",
      "cbor_length": 83,

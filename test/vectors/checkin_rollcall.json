    {
      "name": "checkin_coord_range",
      "description": "Valid coordinate ranges for check-in position fields (same as SOS per spec).",
      "lat_range": {
        "min": -90.0,
        "max": 90.0
      },
      "lon_range": {
        "min": -180.0,
        "max": 180.0
      },
      "expected": {
        "coordinate_validation": "inclusive_bounds",
        "note": "Ranges are inclusive; non-finite values must be rejected"
      }
    },
    {
      "name": "checkin_node_format",
      "description": "Node field is full IPv6 address in colon-hex notation.",
      "valid_node_examples": [
        "0200:0000:0000:0000:0011:2233:4455:6677",
        "fe80:0000:0000:0000:0200:00ff:fe00:0001"
      ],
      "invalid_node_examples": [
        "192.168.1.1",
        "0011:2233:4455:6677",
        ""
      ],
      "expected": {
        "format": "IPv6 full notation (8 groups, colon-separated)"
      }
    },
    {
      "name": "checkin_ts_semantics",
      "description": "Timestamp is Unix epoch seconds per spec 18.6.1.",
      "ts_example": 1716742800,
      "expected": {
        "ts_type": "uint",
        "ts_negative_handling": "reject",
        "note": "Negative timestamps must be rejected"
      }
    },
    {
      "name": "rollcall_ts_semantics",
      "description": "Rollcall timestamp is Unix epoch seconds per spec 18.6.2.",
      "ts_example": 1716742800,
      "expected": {
        "ts_type": "uint",
        "ts_default": "current_time",
        "ts_future_handling": "reject_if_far_future",
        "note": "Far-future timestamps rejected to prevent indefinite rollcalls"
      }
    },
    {
      "name": "rollcall_constants",

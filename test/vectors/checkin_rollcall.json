        "node": "0200:0000:0000:0000:0011:2233:4455:6677",
        "ts": 1716742800,
        "status": "help",
        "msg": "Needs assistance"
      },
      "cbor_hex": "a4646e6f64657827303230303a303030303a303030303a303030303a303031313a323233333a343435353a363637376274731a66536a90667374617475736468656c70636d7367704e6565647320617373697374616e6365",
      "cbor_length": 86,
      "expected": {
        "decode_success": true,
        "response_code": "2.04 Changed",
        "status_value": "help"
      }
    },
    {
      "name": "checkin_status_delayed",
      "description": "Check-in with 'delayed' status indicating schedule slip (spec 18.6.1).",
      "cbor_payload": {
        "node": "0200:0000:0000:0000:0011:2233:4455:6677",
        "ts": 1716742800,
        "status": "delayed",
        "msg": "Weather delay"
      },
      "cbor_hex": "a4646e6f64657827303230303a303030303a303030303a303030303a303031313a323233333a343435353a363637376274731a66536a90667374617475736764656c61796564636d73676d576561746865722064656c6179",
      "cbor_length": 85,
      "expected": {
        "decode_success": true,
        "response_code": "2.04 Changed",
        "status_value": "delayed"
      }
    },

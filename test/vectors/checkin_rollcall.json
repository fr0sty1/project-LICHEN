{
  "$schema": "./schema.json",
  "format_version": 2,
  "name": "checkin_rollcall",
  "description": "Check-In and Roll Call CBOR encoding test vectors per spec Section 18.6. Check-in (18.6.1) requires node, ts, status fields with optional lat, lon, msg. Roll call (18.6.2) requires id field with optional ts, timeout_s, from.",
  "spec": "spec/12-apps.md Section 18.6",
  "vectors": [
    {
      "name": "checkin_minimal",
      "description": "Minimal check-in with required fields only: node, ts, status (spec 18.6.1).",
      "cbor_payload": {
        "node": "0200:0000:0000:0000:0011:2233:4455:6677",
        "ts": 1716742800,
        "status": "ok"
      },
      "cbor_hex": "a3646e6f64657827303230303a303030303a303030303a303030303a303031313a323233333a343435353a363637376274731a66536a9066737461747573626f6b",
      "cbor_length": 64,
      "expected": {
        "decode_success": true,
        "response_code": "2.04 Changed",
        "fields_present": ["node", "ts", "status"]
      }
    },
    {
      "name": "checkin_full",
      "description": "Full check-in with all fields per spec 18.6.1.",
      "cbor_payload": {
        "node": "0200:0000:0000:0000:0011:2233:4455:6677",
        "ts": 1716742800,
        "lat": 37.77,
        "lon": -122.42,
        "status": "ok",
        "msg": "At checkpoint 2"
      },
      "cbor_hex": "a6646e6f64657827303230303a303030303a303030303a303030303a303031313a323233333a343435353a363637376274731a66536a90636c6174fb4042e28f5c28f5c3636c6f6efbc05e9ae147ae147b66737461747573626f6b636d73676f417420636865636b706f696e742032",
      "cbor_length": 110,
      "expected": {
        "decode_success": true,
        "response_code": "2.04 Changed",
        "fields_present": ["node", "ts", "lat", "lon", "status", "msg"]
      }
    },
    {

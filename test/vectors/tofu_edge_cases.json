{
  "$schema": "./schema.json",
  "format_version": 2,
  "name": "tofu_edge_cases",
  "description": "Cross-language TOFU state-machine edge cases covering contact, binding, malformed input, durable rollback, reboot, concurrency, and replay.",
  "spec": "spec/06-security.md#trust-on-first-use-tofu",
  "vectors": [
    {
      "name": "first_contact",
      "category": "contact",
      "description": "A valid first observation is pinned before it is accepted.",
      "initial_state": "empty",
      "operation": "observe",
      "pubkey_hex": "4cb5abf6ad79fbf5abbccafcc269d85cd2651ed4b885b5869f241aedf0a5ba29",
      "iid_hex": "fd6b265c8585369b",
      "repetitions": 1,
      "concurrent_observers": 1,
      "persistence": "ok",
      "expected": {
        "result": "pin_and_accept",
        "entry_count": 1,
        "state_unchanged": false,
        "durable_commits": 1
      }
    },
    {
      "name": "idempotent_repeat",
      "category": "contact",
      "description": "Repeating the pinned identity accepts it without adding a second entry.",
      "initial_state": "alice_pinned",
      "operation": "observe",
      "pubkey_hex": "4cb5abf6ad79fbf5abbccafcc269d85cd2651ed4b885b5869f241aedf0a5ba29",

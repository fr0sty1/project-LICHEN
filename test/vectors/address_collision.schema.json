{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LICHEN authenticated IPv6 address collision vectors",
  "type": "object",
  "required": ["$schema", "format_version", "name", "description", "claim_lifetime_seconds", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "./address_collision.schema.json"},
    "format_version": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "claim_lifetime_seconds": {"const": 1200},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/scenario"}
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "required": ["name", "max_addresses", "max_keys_per_address", "operations"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "max_addresses": {"type": "integer", "minimum": 1},
        "max_keys_per_address": {"type": "integer", "minimum": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/operation"}
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["op", "now_s", "expected_size"],
      "additionalProperties": false,
      "properties": {
        "op": {"enum": ["observe", "observe_bound_native", "query", "restart"]},
        "address": {"type": "string", "minLength": 1},
        "link_scope": {"type": "string", "minLength": 1},
        "public_key_hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"},
        "source": {"type": "string", "minLength": 1},
        "now_s": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "expected_size": {"type": "integer", "minimum": 0},
        "expected_status": {"enum": ["new", "idempotent", "collision"]},
        "expected_collision": {"type": "boolean"},
        "expected_key_count": {"type": "integer", "minimum": 0},
        "expected_expires_at_s": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "expected_error": {
          "enum": ["invalid_source", "address_capacity", "key_capacity", "missing_scope", "native_scope", "time_regression", "timestamp_overflow", "binding_mismatch", "invalid_key_length", "invalid_key_point", "invalid_native_address"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "observe"}}},
          "then": {
            "required": ["address", "public_key_hex", "source"],
            "properties": {"public_key_hex": {"pattern": "^[0-9a-f]{64}$"}},
            "oneOf": [
              {"required": ["expected_status", "expected_collision", "expected_key_count", "expected_expires_at_s"]},
              {"required": ["expected_error"]}
            ]
          }
        },
        {
          "if": {"properties": {"op": {"const": "observe_bound_native"}}},
          "then": {
            "required": ["address", "public_key_hex", "source"],
            "oneOf": [
              {"required": ["expected_status", "expected_collision", "expected_key_count", "expected_expires_at_s"]},
              {"required": ["expected_error"]}
            ]
          }
        },
        {
          "if": {"properties": {"op": {"const": "query"}}},
          "then": {
            "required": ["address"],
            "oneOf": [
              {"required": ["expected_collision", "expected_key_count"]},
              {"required": ["expected_error"]}
            ]
          }
        },
        {
          "if": {"properties": {"op": {"const": "restart"}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["address"]},
                {"required": ["public_key_hex"]},
                {"required": ["source"]},
                {"required": ["expected_status"]},
                {"required": ["expected_collision"]},
                {"required": ["expected_key_count"]},
                {"required": ["expected_expires_at_s"]},
                {"required": ["expected_error"]}
              ]
            }
          }
        }
      ]
    }
  }
}

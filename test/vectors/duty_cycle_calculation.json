{
  "$schema": "./schema.json",
  "format_version": 2,
  "description": "Cross-implementation duty-cycle calculations: exact LoRa airtime, EU868 1% accumulation and rolling-window boundaries, US915 FCC dwell limits, denial/recovery, and u64 timestamp saturation.",
  "vectors": [
    {
      "name": "sf9_exact_airtime_and_packet_budgets",
      "description": "The integer Semtech oracle gives 369.664 ms for a 60-byte SF9/125 kHz/CR4/5 packet; floor division yields 97 packets at EU 1% and 973 in the spec's 10% example.",
      "category": "exact_airtime",
      "radio": {
        "payload_len": 60,
        "spreading_factor": 9,
        "bandwidth_hz": 125000,
        "coding_rate": 5,
        "preamble_symbols": 8,
        "crc_enabled": true,
        "implicit_header": false
      },
      "expected": {
        "airtime_us": 369664,
        "eu_1_percent_packets_per_hour": 97,
        "spec_10_percent_packets_per_hour": 973
      }
    },
    {
      "name": "eu868_exact_limit_denial",
      "description": "EU868 accepts exactly 36 seconds in a one-hour window and denies one more millisecond.",
      "category": "tracking",
      "profile": {
        "region": "EU868",
        "duty_permille": 10,
        "duty_cycle_percent": 1.0,
        "window_ms": 3600000,
        "max_dwell_time_ms": null
      },
      "transmissions": [
        {
          "start_ms": 0,
          "duration_ms": 36000
        }
      ],
      "query_ms": 0,
      "proposed_duration_ms": 1,
      "expected": {
        "used_ms": 36000,
        "remaining_ms": 0,
        "usage_permille": 10,
        "can_transmit": false
      }
    },
    {
      "name": "eu868_accumulates_multiple_transmissions",
      "description": "Three transmissions accumulate using integer milliseconds without rounding their sum.",
      "category": "tracking",
      "profile": {
        "region": "EU868",
        "duty_permille": 10,
        "duty_cycle_percent": 1.0,
        "window_ms": 3600000,
        "max_dwell_time_ms": null
      },
      "transmissions": [
        {
          "start_ms": 1000,
          "duration_ms": 1234
        },
        {
          "start_ms": 5000,
          "duration_ms": 5678
        },
        {
          "start_ms": 12000,
          "duration_ms": 9012
        }
      ],
      "query_ms": 12000,
      "proposed_duration_ms": 20076,
      "expected": {
        "used_ms": 15924,
        "remaining_ms": 20076,
        "usage_permille": 4,
        "can_transmit": true
      }
    },
    {
      "name": "rolling_boundary_still_denied",

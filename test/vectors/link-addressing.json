{
  "$schema": "./schema.json",
  "format_version": 2,
  "description": "LICHEN link-layer addressing modes (spec 4.3): 4 addressing modes + elided context derivation",
  "spec": "spec/02-physical-link.md section 4.3 and spec/drafts/draft-lichen-link-01.md section 3.3",
  "vectors": [
    {
      "name": "broadcast_none",
      "description": "AddrMode NONE (0): broadcast, 0-byte destination, delivered to all neighbors",
      "addr_mode": 0,
      "addr_mode_name": "NONE",
      "dst_addr": "",
      "dst_len": 0,
      "payload": "1400aabb",
      "encoded": "08000100011400aabb",
      "expected_destination": null,
      "is_broadcast": true
    },
    {
      "name": "short_addr",
      "description": "AddrMode SHORT (1): 16-bit short address 0xabcd, 2 bytes on wire",
      "addr_mode": 1,
      "addr_mode_name": "SHORT",
      "dst_addr": "abcd",
      "dst_len": 2,
      "payload": "1400cc",
      "encoded": "0901020064abcd1400cc",
      "expected_destination": "fe80::ff:fe00:abcd",
      "is_broadcast": false
    },
    {
      "name": "short_addr_reserved_null",
      "description": "AddrMode SHORT: 0x0000 is reserved (null/unspecified) - destination resolution MUST fail",
      "addr_mode": 1,
      "addr_mode_name": "SHORT",
      "dst_addr": "0000",
      "dst_len": 2,
      "payload": "1400",
      "encoded": "080100000000001400",
      "expected_destination": null,
      "is_broadcast": false,
      "is_reserved": true,
      "expected_error": "reserved short address"
    },
    {
      "name": "short_addr_reserved_unspecified",
      "description": "AddrMode SHORT: 0xFFFE is reserved (802.15.4 unspecified) - destination resolution MUST fail",
      "addr_mode": 1,
      "addr_mode_name": "SHORT",
      "dst_addr": "fffe",
      "dst_len": 2,
      "payload": "1400",
      "encoded": "0801000000fffe1400",
      "expected_destination": null,
      "is_broadcast": false,
      "is_reserved": true,
      "expected_error": "reserved short address"
    },
    {
      "name": "short_addr_reserved_broadcast",
      "description": "AddrMode SHORT: 0xFFFF is reserved (802.15.4 broadcast) - destination resolution MUST fail",
      "addr_mode": 1,
      "addr_mode_name": "SHORT",
      "dst_addr": "ffff",
      "dst_len": 2,
      "payload": "1400",
      "encoded": "0801000000ffff1400",
      "expected_destination": null,
      "is_broadcast": false,
      "is_reserved": true,
      "expected_error": "reserved short address"
    },
    {
      "name": "extended_eui64",
      "description": "AddrMode EXTENDED (2): 64-bit EUI-64, 8 bytes on wire",
      "addr_mode": 2,
      "addr_mode_name": "EXTENDED",
      "dst_addr": "0011223344556677",
      "dst_len": 8,
      "payload": "150102",
      "encoded": "0f020300c80011223344556677150102",
      "expected_destination": "fe80::211:2233:4455:6677",
      "is_broadcast": false
    },
    {
      "name": "extended_eui64_max_epoch",
      "description": "AddrMode EXTENDED with max epoch/seqnum",
      "addr_mode": 2,
      "addr_mode_name": "EXTENDED",
      "dst_addr": "aabbccddeeff0011",
      "dst_len": 8,
      "payload": "1400ff",
      "encoded": "0f02ffffffaabbccddeeff00111400ff",
      "expected_destination": "fe80::a8bb:ccdd:eeff:11",
      "is_broadcast": false
    },
    {
      "name": "elided_link_local",
      "description": "AddrMode ELIDED (3): 0 bytes, destination fe80::2 derived from SCHC payload",
      "addr_mode": 3,
      "addr_mode_name": "ELIDED",
      "dst_addr": "",
      "dst_len": 0,
      "payload": "1400400000000000000001000000000000000233000448d0",
      "encoded": "1c030a01f41400400000000000000001000000000000000233000448d0",
      "expected_destination": "fe80::2",
      "is_broadcast": false,
      "derived_from": "schc_ipv6_dst"
    },
    {
      "name": "elided_link_local_abcd",
      "description": "AddrMode ELIDED: destination fe80::abcd from SCHC",
      "addr_mode": 3,
      "addr_mode_name": "ELIDED",
      "dst_addr": "",
      "dst_len": 0,
      "payload": "1400400000000000000001000000000000abcd33000448d0",
      "encoded": "1c030b01f51400400000000000000001000000000000abcd33000448d0",
      "expected_destination": "fe80::abcd",
      "is_broadcast": false,
      "derived_from": "schc_ipv6_dst"
    },
    {
      "name": "elided_fallback_non_yggdrasil",
      "description": "AddrMode ELIDED: non-02xx destination triggers SCHC rule 255 uncompressed fallback (negative test)",
      "addr_mode": 3,
      "addr_mode_name": "ELIDED",
      "dst_addr": "",
      "dst_len": 0,
      "payload": "14ff60000000000c1140fe800000000000000000000000000001fd00000000000000000000001234567816331633000c1d0c40011234",
      "encoded": "3a030c01f614ff60000000000c1140fe800000000000000000000000000001fd00000000000000000000001234567816331633000c1d0c40011234",
      "expected_destination": "fd00::1234:5678",
      "is_broadcast": false,
      "derived_from": "schc_ipv6_dst"
    },
    {
      "name": "llsec_distinguishes_none",
      "description": "LLSec correctly encodes NONE (mode 0) with 0-byte address",
      "addr_mode": 0,
      "addr_mode_name": "NONE",
      "dst_addr": "",
      "dst_len": 0,
      "llsec": 0,
      "llsec_hex": "00",
      "payload": "14000102",
      "encoded": "080005000a14000102",
      "expected_destination": null,
      "is_broadcast": true,
      "derived_from": null
    },
    {
      "name": "llsec_distinguishes_elided",
      "description": "LLSec correctly encodes ELIDED (mode 3) with 0-byte address",
      "addr_mode": 3,
      "addr_mode_name": "ELIDED",
      "dst_addr": "",
      "dst_len": 0,
      "llsec": 3,
      "llsec_hex": "03",
      "payload": "1400400000000000000001000000000000009933000448d0",
      "encoded": "1c0305000a1400400000000000000001000000000000009933000448d0",
      "expected_destination": "fe80::99",
      "is_broadcast": false,
      "derived_from": "schc_ipv6_dst"
    }
  ]
}

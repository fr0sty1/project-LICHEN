    {
      "name": "out_of_order_zigzag_pattern",
      "description": "Alternating high-low pattern stressing window bitmap updates",
      "sequence": [
        {"epoch": 0, "seqnum": 50, "accept": true, "comment": "highest=50"},
        {"epoch": 0, "seqnum": 20, "accept": true, "reason": "within_window", "offset": 30},

        {"epoch": 0, "seqnum": 7, "accept": false, "reason": "duplicate_in_window", "comment": "already filled"}
      ]
    },
    {
      "name": "out_of_order_progressive_window_slide",
      "description": "Window slides forward while out-of-order packets continue arriving; bitmap bits shift with highest",
      "sequence": [
        {"epoch": 0, "seqnum": 10, "accept": true, "comment": "highest=10, bit0 set"},
        {"epoch": 0, "seqnum": 5, "accept": true, "reason": "within_window", "comment": "bit5 set"},
        {"epoch": 0, "seqnum": 20, "accept": true, "comment": "highest=20, bitmap shifts left 10, bits at 0,10,15"},
        {"epoch": 0, "seqnum": 15, "accept": true, "reason": "within_window", "comment": "bit5 set"},
        {"epoch": 0, "seqnum": 30, "accept": true, "comment": "highest=30, bitmap shifts left 10, bits at 0,5,10,15,20,25"},
        {"epoch": 0, "seqnum": 25, "accept": true, "reason": "within_window", "comment": "bit5 set"},
        {"epoch": 0, "seqnum": 5, "accept": false, "reason": "duplicate_in_window", "offset": 25, "comment": "bit25 set from original seqnum 5 shifted twice"},
        {"epoch": 0, "seqnum": 10, "accept": false, "reason": "duplicate_in_window", "offset": 20, "comment": "bit20 set from original seqnum 10 shifted twice"},
        {"epoch": 0, "seqnum": 15, "accept": false, "reason": "duplicate_in_window", "offset": 15, "comment": "bit15 set from seqnum 15"},
        {"epoch": 0, "seqnum": 0, "accept": true, "reason": "within_window", "offset": 30, "comment": "offset=30 < 32, bit30 not set, fresh"}
      ]
    },
    {
      "name": "out_of_order_interleaved_epochs",
      "description": "Out-of-order within same epoch, then epoch advances, old epoch rejected",
      "sequence": [
        {"epoch": 3, "seqnum": 100, "accept": true},
        {"epoch": 3, "seqnum": 95, "accept": true, "reason": "within_window"},
        {"epoch": 3, "seqnum": 90, "accept": true, "reason": "within_window"},
        {"epoch": 4, "seqnum": 0, "accept": true, "comment": "epoch advances, resets window"},

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LICHEN local-evidence lifetime vectors",
  "type": "object",
  "required": ["$schema", "format_version", "name", "description", "spec", "lifetime_seconds", "default_max_peers", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "./local_evidence.schema.json"},
    "format_version": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "spec": {"type": "string", "minLength": 1},
    "lifetime_seconds": {"const": 1200},
    "default_max_peers": {"type": "integer", "minimum": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/scenario"}
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "required": ["name", "max_peers", "operations"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "max_peers": {"type": "integer", "minimum": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/operation"}
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["op", "destination", "now_s", "expected_size"],
      "additionalProperties": false,
      "properties": {
        "op": {"enum": ["refresh", "has_evidence"]},
        "destination": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "now_s": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "expected_size": {"type": "integer", "minimum": 0},
        "expected_expires_at_s": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "expected_result": {"type": "boolean"},
        "expected_error": {"enum": ["time_regression", "timestamp_overflow", "capacity", "invalid_source"]}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "refresh"}}},
          "then": {
            "required": ["source"],
            "oneOf": [
              {"required": ["expected_expires_at_s"]},
              {"required": ["expected_error"]}
            ]
          }
        },
        {
          "if": {"properties": {"op": {"const": "has_evidence"}}},
          "then": {
            "oneOf": [
              {"required": ["expected_result"]},
              {"required": ["expected_error"]}
            ]
          }
        }
      ]
    }
  }
}

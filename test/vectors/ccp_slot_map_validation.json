{
  "$schema": "./schema.json",
  "format_version": 2,
  "description": "CCP slot_map validation vectors per spec/02a-coordinated-capacity.md:80. slot_map is a CBOR array of u8 in beacon cbor_options. Receivers MUST validate: (1) each entry < num_slots, (2) array is sorted ascending. Empty array indicates no TX slots.",
  "vectors": [
    {
      "name": "slot_out_of_bounds",
      "description": "Reject: slots 8 and 12 are >= num_slots 8",
      "num_slots": 8,
      "slot_map": [0, 3, 8, 12],
      "expected_valid": false,
      "expected_error": "slot_out_of_bounds"
    },
    {
      "name": "slot_unsorted",
      "description": "Reject: array [3, 1, 5, 2] is not sorted ascending",
      "num_slots": 16,
      "slot_map": [3, 1, 5, 2],
      "expected_valid": false,
      "expected_error": "unsorted"
    },
    {
      "name": "slot_boundary_valid",
      "description": "Accept: all slots < 8 and sorted",
      "num_slots": 8,
      "slot_map": [0, 1, 7],
      "expected_valid": true,
      "expected_error": null
    },
    {
      "name": "slot_boundary_invalid",
      "description": "Reject: slot 8 == num_slots (must be strictly less)",
      "num_slots": 8,
      "slot_map": [0, 1, 8],
      "expected_valid": false,
      "expected_error": "slot_out_of_bounds"
    },
    {
      "name": "slot_empty",
      "description": "Accept: empty array means no TX slots assigned",
      "num_slots": 8,
      "slot_map": [],
      "expected_valid": true,
      "expected_error": null
    },
    {
      "name": "slot_duplicate",
      "description": "Reject: duplicates violate sorted-unique invariant for efficiency",
      "num_slots": 8,
      "slot_map": [1, 1, 3],
      "expected_valid": false,
      "expected_error": "duplicate"
    },
    {
      "name": "slot_single_max_valid",
      "description": "Accept: single slot 254 < 255",
      "num_slots": 255,
      "slot_map": [254],
      "expected_valid": true,
      "expected_error": null
    },
    {
      "name": "slot_single_at_limit",
      "description": "Reject: slot 255 == num_slots 255",
      "num_slots": 255,
      "slot_map": [255],
      "expected_valid": false,
      "expected_error": "slot_out_of_bounds"
    },
    {
      "name": "slot_all_valid",
      "description": "Accept: slots 0-7 all valid for num_slots=8",
      "num_slots": 8,
      "slot_map": [0, 1, 2, 3, 4, 5, 6, 7],
      "expected_valid": true,
      "expected_error": null
    },
    {
      "name": "slot_single_zero",
      "description": "Accept: single slot 0 always valid",
      "num_slots": 1,
      "slot_map": [0],
      "expected_valid": true,
      "expected_error": null
    },
    {
      "name": "slot_zero_num_slots",
      "description": "Reject: num_slots=0 makes any slot invalid",
      "num_slots": 0,
      "slot_map": [0],
      "expected_valid": false,
      "expected_error": "slot_out_of_bounds"
    },
    {
      "name": "slot_descending",
      "description": "Reject: [7, 5, 3, 1] is descending, not ascending",
      "num_slots": 8,
      "slot_map": [7, 5, 3, 1],
      "expected_valid": false,
      "expected_error": "unsorted"
    },
    {
      "name": "slot_partial_sorted",
      "description": "Reject: [1, 2, 2, 3] has duplicate at position 2",
      "num_slots": 8,
      "slot_map": [1, 2, 2, 3],
      "expected_valid": false,
      "expected_error": "duplicate"
    },
    {
      "name": "slot_gap_valid",
      "description": "Accept: non-contiguous sorted slots [0, 3, 7]",
      "num_slots": 8,
      "slot_map": [0, 3, 7],
      "expected_valid": true,
      "expected_error": null
    },
    {
      "name": "slot_first_invalid",
      "description": "Reject: first slot 10 already >= num_slots 8",
      "num_slots": 8,
      "slot_map": [10],
      "expected_valid": false,
      "expected_error": "slot_out_of_bounds"
    }
  ]
}

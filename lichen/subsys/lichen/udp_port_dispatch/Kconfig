config LICHEN_UDP_PORT_DISPATCH
	bool "LICHEN UDP application port dispatch"
	depends on LICHEN
	default y
	help
	  Enable bounded destination-port dispatch for the LICHEN application
	  assignments in spec/07-transport-app.md.
